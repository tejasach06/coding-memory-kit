# Export these in each agent process; never commit the API keys.
CODING_MEMORY_MCP_URL=http://192.168.0.9:8000/mcp/
CODING_MEMORY_MCP_API_KEY=
# Needed only for the authenticated forget REST operation.
CODING_MEMORY_QDRANT_REST_URL=http://192.168.0.9:6333
CODING_MEMORY_QDRANT_API_KEY=
CODING_MEMORY_COLLECTION=agent-memories
CODING_MEMORY_TIMEOUT=180
CODING_MEMORY_MAX_BYTES=16384
